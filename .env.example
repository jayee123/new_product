# 複製這個檔案為 .env，填入你自己的 Key
# cp .env.example .env

OPENAI_API_KEY=sk-your-openai-key-here

# MongoDB（本機開發用；正式環境用 MongoDB Atlas 連線字串）
MONGO_URI=mongodb://localhost:27017
MONGO_DB=drugstore_demo

# Google Custom Search（選用，搜圖片用）
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# MySQL（會員系統專用，獨立於商品資料的 MongoDB 之外，見 PROJECT_STATUS.md 第 3-1b 節）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=buytuoleai_auth
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_HOURS=24

# Gemini API（翻譯 + 評論摘要用）
GEMINI_API_KEY=your-gemini-key-here
